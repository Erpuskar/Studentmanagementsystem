
@model StudentManagementSystem.Models.Student

@{
    ViewData["Title"] = "Student Details";
}

<h2>Student Details</h2>

<table class="table table-bordered">
    <tr><th>ID</th><td>@Model.StudentId</td></tr>
    <tr><th>Roll No</th><td>@Model.RollNo</td></tr>
    <tr><th>Name</th><td>@Model.FullName</td></tr>
    <tr><th>Gender</th><td>@Model.Gender</td></tr>
    <tr><th>Email</th><td>@Model.Email</td></tr>
    <tr><th>Phone</th><td>@Model.Phone</td></tr>
    <tr><th>Course</th><td>@Model.Course</td></tr>
    <tr><th>Address</th><td>@Model.Address</td></tr>
</table>

<a asp-action="Index" class="btn btn-secondary">
    Back to List
</a>

<a asp-action="Edit"
   asp-route-id="@Model.StudentId"
   class="btn btn-warning">
    Edit Student
</a>
